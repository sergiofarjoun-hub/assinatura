# Copie para .env e preencha (o .env nunca vai para o git)
ANTHROPIC_API_KEY=sk-ant-...

# Senha de login da UI. Se vazio, o app roda SEM login (só use assim na tailnet).
AGENT_PASSWORD=

# Aprovação humana para comandos bash:
#   sensitive (padrão) = pede aprovação para comandos sensíveis (rm, sudo, git push, ssh...)
#   all                = pede aprovação para TODO comando bash
#   off                = executa tudo sem perguntar
APPROVAL_MODE=sensitive

# Modelo (opcional). Padrão: claude-opus-4-8
# MODEL=claude-opus-4-8

# Caminho do Chromium para a ferramenta de navegador. No Docker o padrão
# /usr/bin/chromium já funciona; descomente só para apontar outro binário.
# Rodando fora do Docker, exporte a variável no shell (o app não lê .env).
# CHROME_PATH=/usr/bin/chromium
