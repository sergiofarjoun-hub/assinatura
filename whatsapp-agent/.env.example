# Copie para .env e preencha. NUNCA commite o .env.

# --- obrigatório ---
# Chave da API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# --- Claude (opcional) ---
# Modelo (padrão: claude-opus-4-8). Para reduzir custo: claude-sonnet-4-6
AGENT_MODEL=claude-opus-4-8
# Profundidade de raciocínio: low | medium | high (padrão: medium — bom p/ chat)
AGENT_EFFORT=medium
# Tamanho máximo da resposta em tokens (padrão: 1024)
MAX_TOKENS=1024

# --- comportamento ---
# Nome exibido nos logs e no !status
BOT_NAME=Assistente Hamsa

# Números ADMIN além do chat "você mesmo" (só dígitos com DDI, separados por vírgula)
# Ex.: ADMIN_NUMBERS=5511999999999,19735550000
ADMIN_NUMBERS=

# Atendimento a clientes: all (todos) | allowlist (só ALLOWED_NUMBERS) | off (desligado)
CLIENT_MODE=all
# Usado só quando CLIENT_MODE=allowlist
ALLOWED_NUMBERS=

# Ao responder um cliente manualmente pelo celular, o bot pausa naquele chat
# por N minutos (0 desliga o handoff automático). Padrão: 60
HANDOFF_PAUSE_MINUTES=60

# Mensagens mantidas na memória por conversa (padrão: 40)
MAX_HISTORY=40

# --- memória de longo prazo por cliente (ficha _FICHA.md) ---
# Quando ligada (e com CLIENTES_DIR configurado), cada cliente identificado ganha
# um _FICHA.md na própria pasta da rede, com: resumo da relação, log de TODA
# interação, e o controle de claims (valores, franquia por pessoa e familiar,
# status pendente/processado). O bot relê a ficha no início de cada conversa
# (memória entre atendimentos) e a atualiza ao final. Defina como false p/ desligar.
FICHA_ENABLED=true

# --- salvamento de documentos dos clientes ---
# Estrutura esperada (aninhada):
#   <base> / <Ramo: SAUDE, VIDA...> / <Operadora: VUMI, Cigna...> / <Cliente>
# O bot procura a pasta do cliente por nº de apólice ou nome (match único e
# seguro), NUNCA cria pasta de cliente, e salva na subpasta 'reembolsos'.
# Não identificados vão para '_a_identificar'. Se a base NÃO existir, o recurso
# fica desligado (não quebra nada).
#
# >>> NO NAS (Docker): NÃO mexa em CLIENTES_DIR. Defina apenas CLIENTES_HOST_DIR
#     com o caminho REAL da pasta de clientes no NAS; o compose monta ela em
#     /clientes dentro do container.
CLIENTES_DIR=/clientes
CLIENTES_HOST_DIR=/volume1/EDITE_AQUI/CLIENTES
#
# >>> NO MAC (npm start / launchd): comente as duas linhas acima e use:
# CLIENTES_DIR=/Users/hamsa/SERVER/CLIENTES
#
# Nome da subpasta criada dentro da pasta do cliente (padrão: reembolsos)
CLIENTES_SUBPASTA=reembolsos

# --- notificação por e-mail (quem submeteu cada documento) ---
# Quando configurado, o bot envia um e-mail para NOTIFY_EMAIL toda vez que
# arquiva um documento, dizendo o cliente, operadora, apólice, WhatsApp e onde
# salvou. Sem SMTP_* + NOTIFY_EMAIL, o recurso fica desligado (não quebra nada).
NOTIFY_EMAIL=sergio@chamsa.com.br
# SMTP do remetente. Ex. Gmail: host smtp.gmail.com, porta 587, SMTP_SECURE=false,
# SMTP_USER=seu@gmail.com, SMTP_PASS=<senha de app de 16 dígitos> (não a senha normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Remetente exibido (padrão: SMTP_USER)
SMTP_FROM=

# --- conhecimento de produto (ingestão das seguradoras) ---
# Pasta "SEGUROS SAUDE" montada no container (só na ingestão, read-only).
# No NAS o host é /volume1/SERVER/SEGUROS SAUDE. Deixe vazio para desligar.
PRODUTOS_DIR=
# Subpastas de foco dentro de cada seguradora (as que têm produto/condições).
PRODUTOS_SUBPASTAS=BROCHURAS,APOLICES
# Cofre de conhecimento (Obsidian) — o bot lê as fichas de produto daqui, e as
# ingestões (MA e PDF) gravam uma pasta por seguradora aqui dentro. A ingestão
# de PDF também copia o PDF ORIGINAL de cada brochura para
# <seguradora>/Brochuras/ — é dali que o bot ENVIA o PDF quando o cliente pede
# o material da brochura (não só uma explicação).
# No NAS o container vê o cofre em /base_conhecimento (montado pelo compose a
# partir de BASE_CONHECIMENTO_HOST_DIR). Defina PRODUTOS_KB_DIR=/base_conhecimento.
BASE_CONHECIMENTO_HOST_DIR=/volume1/SERVER/BASE_CONHECIMENTO
PRODUTOS_KB_DIR=/base_conhecimento
# Teto de caracteres do corpus por seguradora (acima disso quebra em partes e
# consolida, para capturar TODOS os produtos da linha). Custo cresce com isto.
PRODUTOS_MAX_CHARS=300000
# Filtro opcional de seguradoras (vírgula). Vazio = todas. Comece com poucas:
# PRODUTOS_CARRIERS=VUMI,EVER,REDBRIDGE,TRAWICK
PRODUTOS_CARRIERS=
# Teto de caracteres das fichas carregadas no prompt do bot (todas somadas).
PRODUTOS_KB_MAX_CHARS=160000

# --- plano/franquia ATUAIS (banco do RENOVACOES APP, só leitura) ---
# Fonte de verdade do plano e da franquia atuais do cliente (última renovação).
# RENOVACOES_DB_HOST = pasta no NAS que contém o renovacoes.db (+ -wal/-shm).
# No container ela é montada em /renovacoes, e RENOVACOES_DB aponta pro arquivo.
# Sem isso, o bot cai no fallback (lê o documento mais recente da pasta).
RENOVACOES_DB_HOST=/volume1/Sistema/RENOVACOES APP/repo/data
RENOVACOES_DB=/renovacoes/renovacoes.db
