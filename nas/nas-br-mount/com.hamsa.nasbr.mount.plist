<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hamsa.nasbr.mount</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/hamsa/Library/Scripts/mount-nas-br.sh</string>
  </array>

  <!-- Roda no login e a cada 60 segundos: se a conexão cair, remonta em até 1 min -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>

  <key>StandardErrorPath</key>
  <string>/Users/hamsa/Library/Logs/nas-br-mount.err.log</string>
</dict>
</plist>
